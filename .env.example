# NVIDIA NIM — default LLM (free at build.nvidia.com)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v4-pro
LLM_MAX_TOKENS=2048
LLM_MAX_CALLS_PER_ANALYSIS=25
LLM_ENABLED=true
# Per-attempt API timeout (seconds); a dead LLM endpoint must not stall analysis
LLM_TIMEOUT_SECONDS=45

# Optional enrichment
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Database
DATABASE_URL=sqlite:///packeteye.db

# Dev mode (no Redis)
CELERY_TASK_ALWAYS_EAGER=true
CACHE_TYPE=SimpleCache

# ML / NIDS baseline (run scripts/train_baseline.py first)
ML_MODEL_PATH=ml_models/isolation_forest_base.pkl
ML_SCALER_PATH=ml_models/feature_scaler.pkl
ML_FEATURE_SCHEMA_PATH=ml_models/feature_schema.json
ML_SCORE_CALIBRATION_PATH=ml_models/score_calibration.json
# 0-10 anomaly scale; 5.0 == Isolation Forest decision boundary.
# Run scripts/tune_threshold.py after training and use its recommendation.
ML_ANOMALY_THRESHOLD=5.0
ML_TRAIN_ON_PCAP_FALLBACK=false
MAX_FLOWS_ML_SCORING=50000

# Live NIDS (Suricata) — paste full path to eve.json on /live page
# Live monitor (Suricata EVE tail + ML scoring). On Linux sensors run as root:
#   sudo python run.py
LIVE_MONITOR_ENABLED=true
SURICATA_EVE_PATH=data/suricata/eve.json
LIVE_ALERT_RATE_LIMIT=60
LIVE_PORT_ENTROPY_WINDOW=300
# Also surface Suricata signature hits (event_type=alert) in the live feed
LIVE_INGEST_SURICATA_ALERTS=true

# Replay uploaded PCAPs against the saved Suricata rules during detection
PCAP_SURICATA_ENABLED=true

# Suricata process management — auto-uses /etc/suricata/suricata.yaml when present (Kali)
# SURICATA_BIN=C:\Program Files\Suricata\suricata.exe
SURICATA_BIN=suricata
# Leave empty to auto-detect: /etc/suricata/suricata.yaml then deploy/suricata/suricata.yaml
SURICATA_CONFIG_PATH=
SURICATA_INTERFACE=eth0
SURICATA_LOG_DIR=data/suricata
SURICATA_CUSTOM_RULES_PATH=deploy/suricata/custom.rules
# Block loopback (lo) for live capture unless you are testing locally
SURICATA_ALLOW_LOOPBACK=false

# Unified capture (Linux sensor on mirrored traffic) — start/stop from browser
CAPTURE_MODE=suricata            # suricata | tcpdump
CAPTURE_INTERFACE=eth1           # your mirror/SPAN port
CAPTURE_STATE_DIR=data/capture
TCPDUMP_BIN=tcpdump
# Leave empty for auto (Linux: /tmp/packeteye/chunks-<uid> or /var/log/packeteye/chunks as root).
# Do NOT use a path under $HOME on Kali — AppArmor blocks tcpdump PCAP writes there.
TCPDUMP_CHUNK_DIR=
CAPTURE_USE_SUDO=true
TCPDUMP_CHUNK_SECONDS=300
TCPDUMP_CHUNK_KEEP=10

# Enrichment strategy: on_investigate (per-alert OSINT) | bulk (legacy PCAP-wide)
ENRICHMENT_MODE=on_investigate
AUTO_INVESTIGATE_LIVE=false
LIVE_CORRELATION_WINDOW=120

# Alert webhooks (Discord-compatible). Empty = disabled.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_MIN_SEVERITY=high
ALERT_WEBHOOK_RATE_LIMIT=10

# SOC chatbot (uses the LLM_* provider above)
CHATBOT_ENABLED=true
CHATBOT_MAX_HISTORY=10
