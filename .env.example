# Flask
SECRET_KEY=change_me_in_production
FLASK_ENV=development
UPLOAD_FOLDER=./data/uploads
MAX_UPLOAD_MB=500

# Database
DATABASE_URL=sqlite:///packeteye.db

# Redis / Celery (optional in dev — see README)
REDIS_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=true
# CACHE_TYPE=SimpleCache

# LLM — NVIDIA NIM (default, free tier at build.nvidia.com)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=your_nvapi_key_from_build.nvidia.com
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
LLM_MODEL=deepseek-ai/deepseek-v4-pro
# Faster/cheaper alternative: deepseek-ai/deepseek-v4-flash
LLM_MAX_TOKENS=2048
LLM_MAX_CALLS_PER_ANALYSIS=25
LLM_ENABLED=true

# Optional: OpenAI or Anthropic instead of NVIDIA
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o

# Enrichment APIs (all optional)
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
ANYRUN_API_KEY=

# MaxMind GeoLite2 (optional)
MAXMIND_DB_PATH=

# Analysis tuning
ML_ANOMALY_THRESHOLD=7.5
ENRICHMENT_CACHE_TTL_HOURS=24
MAX_FLOWS_ML_SCORING=50000
WHITELIST_ENABLED=true
PCAP_RETENTION_DAYS=30
