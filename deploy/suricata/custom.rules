# packetEye custom Suricata rules — edit from Live Monitor → Suricata & Rules
# Each rule needs a unique sid in the 1000000+ range.

alert tcp any any -> $HOME_NET 22 (msg:"SSH brute force attempt"; flags:S; threshold:type both, track by_src, count 20, seconds 60; sid:1000001; rev:1;)

alert tcp any any -> $HOME_NET 3389 (msg:"Possible RDP scan"; flags:S; threshold:type both, track by_src, count 10, seconds 60; sid:1000002; rev:1;)
